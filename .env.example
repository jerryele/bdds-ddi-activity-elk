# Copy to .env and edit. install.sh does this for you (it asks for / detects HOST_IP).

# REQUIRED: IP or DNS name that BDDS (and anything else outside docker) uses to reach this host.
# Kafka advertises this address to clients; a wrong value = BDDS connects but cannot produce.
HOST_IP=192.168.1.250

# Retention for both Kafka topics and Elasticsearch indices (days)
RETENTION_DAYS=7

# Host ports
KAFKA_PORT=9094
KIBANA_PORT=5601
KAFKA_UI_PORT=8082

# Versions (keep Elasticsearch / Logstash / Kibana on the same version)
STACK_VERSION=8.17.0
KAFKA_VERSION=3.9.0

# JVM heaps. Sizing guide: ES ~ 25% of RAM (max 31g), Logstash 1g, Kafka 1g.
ES_HEAP=3g
LS_HEAP=1g
KAFKA_HEAP=1g
